# Copy to .env.local and fill in. None of these are secrets.

# Google OAuth client (Web application). Add http://localhost:5173 and your
# GitHub Pages origin to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Where documents are saved: "drive" (default) or "s3".
VITE_STORAGE=drive

# Only needed when VITE_STORAGE=s3. See README for the AWS setup.
VITE_AWS_REGION=us-east-1
VITE_S3_BUCKET=
VITE_COGNITO_IDENTITY_POOL_ID=
